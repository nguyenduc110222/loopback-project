{
  "name": "loopback-backend",
  "version": "1.0.0",
  "description": "Loopback REST API Backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "lb-tsc",
    "start": "node -r ./node_modules/@loopback/context/dist/index.js dist/index.js",
    "dev": "lb-tsc && node -r ./node_modules/@loopback/context/dist/index.js dist/index.js",
    "lint": "eslint --ext .ts .",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@loopback/boot": "^8.0.0",
    "@loopback/context": "^8.0.0",
    "@loopback/core": "^8.0.0",
    "@loopback/openapi-v3": "^8.0.0",
    "@loopback/rest": "^14.0.0",
    "@loopback/rest-explorer": "^8.0.0",
    "@loopback/service-proxy": "^8.0.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@loopback/build": "^10.1.0",
    "@loopback/eslint-config": "^14.0.0",
    "@loopback/testlab": "^7.1.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "typescript": "~5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}